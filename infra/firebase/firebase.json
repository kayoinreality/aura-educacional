{
  "hosting": [
    {
      "target": "web",
      "public": "public-stub",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "aura-web",
            "region": "southamerica-east1"
          }
        }
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|png|webp|avif|svg|ico|woff2)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "target": "learn",
      "public": "public-stub",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "run": { "serviceId": "aura-learn", "region": "southamerica-east1" }
        }
      ]
    },
    {
      "target": "admin",
      "public": "public-stub",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "run": { "serviceId": "aura-admin", "region": "southamerica-east1" }
        }
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
