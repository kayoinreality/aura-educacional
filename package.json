{
  "name": "aura-educacional",
  "private": true,
  "version": "2.0.0",
  "description": "Aura Educacional — plataforma de cursos livres com assinatura e certificados",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @aura/db generate",
    "db:migrate": "pnpm --filter @aura/db migrate",
    "db:seed": "pnpm --filter @aura/db seed",
    "db:studio": "pnpm --filter @aura/db studio",
    "dev:web": "pnpm --filter @aura/web dev",
    "dev:learn": "pnpm --filter @aura/learn dev",
    "dev:admin": "pnpm --filter @aura/admin dev",
    "dev:api": "pnpm --filter @aura/api dev"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
