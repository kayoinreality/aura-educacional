# =============================================================================
# Aura Educacional — variáveis de ambiente
# Stack: Firebase Hosting + Cloud Run (Next.js SSR + Hono API) + Cloud SQL
# =============================================================================

# --- Database (Cloud SQL Postgres em southamerica-east1) ---
# Local dev: postgresql://postgres:postgres@localhost:5432/aura
# Cloud Run: usa Unix socket via Cloud SQL Auth Proxy ou conexão privada (VPC)
DATABASE_URL="postgresql://aura_app:CHANGE_ME@/aura?host=/cloudsql/PROJECT:REGION:INSTANCE"
DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/aura"

# --- Firebase (cliente) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="auraeducacional.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="auraeducacional"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="auraeducacional.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin (servidor) ---
# Em Cloud Run, prefira Application Default Credentials via service account anexada.
# Para dev local, baixe a service account JSON e aponte:
GOOGLE_APPLICATION_CREDENTIALS="./infra/gcp/service-account.json"
FIREBASE_PROJECT_ID="auraeducacional"

# --- App URLs ---
NEXT_PUBLIC_WEB_URL="https://auraeducacional.com.br"
NEXT_PUBLIC_LEARN_URL="https://app.auraeducacional.com.br"
NEXT_PUBLIC_ADMIN_URL="https://admin.auraeducacional.com.br"
NEXT_PUBLIC_API_URL="https://api.auraeducacional.com.br"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_YEARLY="price_..."

# --- Mux Video ---
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_KEY_PRIVATE=""        # base64 da chave privada
MUX_WEBHOOK_SECRET=""

# --- Resend (email) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="contato@auraeducacional.com.br"

# --- Google Cloud ---
GCP_PROJECT_ID="auraeducacional"
GCP_REGION="southamerica-east1"
GCS_BUCKET_FILES="aura-files"             # capas, anexos
GCS_BUCKET_CERTIFICATES="aura-certificates"
CLOUD_TASKS_QUEUE_CERT="cert-generation"
CLOUD_TASKS_QUEUE_EMAIL="email-dispatch"
CLOUD_TASKS_QUEUE_WEBHOOK="webhook-processor"

# --- Sentry (opcional) ---
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# --- Empresa (rodapé do certificado) ---
COMPANY_NAME="Aura Educacional"
COMPANY_CNPJ=""
COMPANY_ADDRESS=""
